# DayBuddy AI — backend config

# Port the Express server listens on
# (5000 is avoided — macOS AirPlay Receiver uses it)
PORT=5001

# Gemma 4 (open-source model) via the Gemini API.
# Free key: https://aistudio.google.com/apikey
GEMMA_API_KEY=
GEMMA_API_MODEL=gemma-4-26b-a4b-it

# Max time (ms) to wait for the model before using the rule-based fallback
GEMMA_TIMEOUT_MS=45000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/daybuddy
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/daybuddy
# If Mongo is unreachable, the backend falls back to in-memory storage.
MONGODB_URI=mongodb://127.0.0.1:27017/daybuddy

# A single demo user id (multi-user auth comes later).
DEFAULT_USER_ID=demo-user

# Origin allowed to call the API from a browser ("*" allows any; set your
# frontend URL in production, e.g. https://daybuddy.app).
CORS_ORIGIN=*

# Voice (optional): ElevenLabs speech-to-text + text-to-speech.
# Without a key the app uses the browser's own speech recognition.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Sentry agent tracing (optional): paste the DSN of a Node/Express project.
SENTRY_DSN=
